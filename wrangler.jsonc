{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lagbyggaren",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-09-08",
  "workers_dev": true,
  "preview_urls": false,
  "assets": { "directory": ".worker-assets", "binding": "ASSETS", "run_worker_first": ["/api/*", "/config.js", "/health"] },
  "build": { "command": "node scripts/build-cloudflare.mjs" },
  "vars": { "AUTH_MODE": "links" },
  "d1_databases": [{ "binding": "DB", "database_name": "lagbyggaren", "database_id": "a081dd05-8320-4f5f-8124-c53204c5b1a8", "migrations_dir": "migrations" }],
  "observability": { "enabled": false }
}
